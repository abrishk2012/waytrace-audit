# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# YOLO model weights (re-downloaded automatically)
*.pt

# Video files (too large for Git)
*.avi
*.mp4
*.mov
*.mkv

# Processed output
data/output/*
!data/output/.gitkeep
# results are small and are the evidence - keep them
!data/output/results*.json
!data/output/hotspots*.json
!data/output/heatmap*.png

# OS junk
Thumbs.db
desktop.ini
.DS_Store
data/*.png
